{
    "name": "ithilbert/ai-manifest",
    "type": "library",
    "license": "MIT",
    "description": "KI-Agenten-Auffindbarkeit für Laravel – ARD-Manifest (/.well-known/ard.json) aus Routen mit ->aiManifest(), llms.txt und Link-Komponente rel=\"ard\".",
    "keywords": [
        "it-hilbert",
        "laravel",
        "ai-manifest",
        "ard",
        "agent-resource-discovery",
        "llms.txt",
        "discovery",
        "ai-agent"
    ],
    "authors": [{
        "name": "Jörg Hilbert",
        "homepage": "https://www.it-hilbert.com",
        "role": "Developer"
    }],
    "homepage": "https://www.it-hilbert.com",
    "minimum-stability": "stable",
    "require": {
        "php": "^8.5",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/routing": "^12.0 || ^13.0",
        "illuminate/filesystem": "^12.0 || ^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "ITHilbert\\AiManifest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ITHilbert\\AiManifest\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "ITHilbert\\AiManifest\\AiManifestServiceProvider"
            ],
            "aliases": {
                "AiManifest": "ITHilbert\\AiManifest\\Facades\\AiManifest"
            }
        }
    }
}
